rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function rahbar() {
      return request.auth != null
        && request.auth.token.email == "rahbar@dorixona-hisoboti.app";
    }
    function mine(ph) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ph == ph;
    }
    match /users/{uid} {
      allow read: if rahbar() || (request.auth != null && request.auth.uid == uid);
      allow write: if rahbar();
    }
    match /ph/{ph} {
      allow read: if rahbar() || mine(ph);
      allow write: if rahbar();
    }
    match /ph/{ph}/{rest=**} {
      allow read: if rahbar() || mine(ph);
      allow write: if mine(ph);
    }
  }
}
